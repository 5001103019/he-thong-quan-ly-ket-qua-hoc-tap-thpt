
# ==================================================
# HE THONG QUAN LY KET QUA HOC TAP HOC SINH THPT
# Nhom 5 - Cau hinh moi truong mau
# ==================================================

# --------------------------------------------------
# 1. SERVER
# --------------------------------------------------

NODE_ENV=development
PORT=3000

# --------------------------------------------------

# --------------------------------------------------
# 2. DATABASE - MICROSOFT SQL SERVER
# --------------------------------------------------

DB_SERVER=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_NAME=thpt_grade_management

# Windows Authentication
DB_AUTH=windows

# Khong can tai khoan SQL khi dung Windows Authentication
DB_USER=
DB_PASSWORD=

# --------------------------------------------------
# 3. DATABASE SECURITY
# --------------------------------------------------

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true


# --------------------------------------------------
# 4. AUTHENTICATION
# --------------------------------------------------

# Su dung khi backend trien khai JWT
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Su dung khi backend trien khai Session
SESSION_SECRET=
SESSION_COOKIE_SECURE=false

# ==================================================
# LUU Y
# ==================================================

# 1. Day la file cau hinh mau.
# 2. Khong luu mat khau hoac secret that tai day.
# 3. Thong tin that chi duoc luu trong file .env.
# 4. File .env phai duoc dua vao .gitignore.
# 5. DB_PORT va DB_INSTANCE khong duoc truyen
#    dong thoi vao driver mssql.
# 6. Khi trien khai production, su dung chung chi
#    hop le va dat DB_TRUST_SERVER_CERTIFICATE=false.
# 7. Backend chi su dung JWT hoac Session theo
#    phuong an xac thuc duoc nhom trien khai.
